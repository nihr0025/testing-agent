# ==============================================================================
# TraceAI Studio - Environment Configuration
# All API keys and secrets must ONLY be placed in this backend .env file.
# The frontend NEVER accepts or stores API keys.
# ==============================================================================

# Testing Mode Preference: 'basic', 'gemini', or 'openai'
# If an API key is missing or quota is exhausted, Basic Mode runs automatically.
DEFAULT_TESTING_MODE=basic

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Official Google Gen AI SDK)
# Free-tier access available via Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
# Alternative environment variable name recognized for Gemini:
# GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ------------------------------------------------------------------------------
# Default Browser Automation Framework ('playwright' or 'selenium')
# ------------------------------------------------------------------------------
DEFAULT_AUTOMATION_FRAMEWORK=playwright

# ------------------------------------------------------------------------------
# Jira Cloud Integration (Optional / MCP Connectivity)
# ------------------------------------------------------------------------------
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_MCP_URL=

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
